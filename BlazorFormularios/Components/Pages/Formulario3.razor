@page "/formulario-comvalidacaoValidationSummary"
@rendermode InteractiveServer

<h3>Cadastro de Alunos (Validação com ValidationSummary)</h3>

<EditForm Model="@aluno"
          OnValidSubmit="EnviarFormularioValido"
          OnInvalidSubmit="TratarFormularioInvalido">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="nome">Nome:</label>
        <InputText id="nome" @bind-Value="aluno.Nome" class="form-control" />
    </div>

    <div class="form-group">
        <label for="email">Email:</label>
        <InputText id="email" @bind-Value="aluno.Email" class="form-control" />
    </div>

    <div class="form-group">
        <label for="idade">Idade:</label>
        <InputNumber id="idade" @bind-Value="aluno.Idade" class="form-control" />
    </div>

    <div class="mt-2">
        <input type="submit" value="Enviar" class="btn btn-primary" />
    </div>


</EditForm>

@code {
    Aluno aluno = new();

    private void EnviarFormularioValido(EditContext args)
    {
        Console.WriteLine($"Formulário Válido");
    }
    private void TratarFormularioInvalido(EditContext args)
    {
        Console.WriteLine($"Formulário Inválido");
    }
}
