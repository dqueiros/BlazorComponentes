<button class="btn btn-warning" @onclick="NotificarPai">
    Botão no Componente Filho
</button>

@code {
    [Parameter]
    public EventCallback OnClicouNoFilho { get; set; }

    private Task NotificarPai()
    {
        // Invoca o callback fornecido pelo componente pai
        return OnClicouNoFilho.InvokeAsync();
    }
}
