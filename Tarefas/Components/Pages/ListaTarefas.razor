@if (ListaDeTarefas == null)
{
    <img src="https://media.giphy.com/media/3oEjI6SIIHBdRxXI40/giphy.gif" />
    <Aviso Mensagem="Carregando..." />
}
else if (!ListaDeTarefas.Any())
{
    <Aviso Mensagem="Ainda não existem tarefas..." />
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ação</th>
                <th>Data</th>
                <th>Descriçao</th>
                <th>Concluida</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tarefaItem in ListaDeTarefas)
            {
                <TarefaIndividual TarefaItem="tarefaItem" OnRemoverTarefa="HandleRemoveTarefa" />
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired]
    public List<Tarefa> ListaDeTarefas { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnRemoverTarefa { get; set; }

    private async Task HandleRemoveTarefa(Guid id)
    {
        await OnRemoverTarefa.InvokeAsync(id);
    }
}
